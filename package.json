    "@hono/zod-openapi": "^0.18.3",
    "@scalar/hono-api-reference": "^0.5.16",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "drizzle-kit": "^0.24.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.105.1"
  }
}
