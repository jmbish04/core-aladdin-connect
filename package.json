{
  "name": "colby-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "migrate:remote": "node ./scripts/migrate-remote.mjs",
    "deploy": "npm run build && npm run db:generate && npm run migrate:remote && npx wrangler deploy"
  },
  "dependencies": {
